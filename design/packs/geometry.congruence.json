  "problems": {
    "proof": {
      "params": {
        "mode": {
          "type": "enum",
          "values": [
            "build",
            "fillIn"
          ],
          "default": "build"
        },
        "minSteps": {
          "type": "int",
          "min": 2,
          "max": 12,
          "default": 4
        },
        "maxSteps": {
          "type": "int",
          "min": 3,
          "max": 14,
          "default": 8
        }
      },
      "generate": [
        {
          "set": "fig",
          "to": "pick(figures)"
        },
        {
          "set": "vals",
          "to": "mapValues(fig.params, e => calc(e))"
        },
        {
          "set": "pts",
          "to": "realize(fig.points, vals)"
        },
        {
          "require": "all(fig.candidateGivens, g => holds(g, pts)) && all(fig.goals, g => holds(g, pts))"
        },
        {
          "set": "goal",
          "to": "pick(fig.goals)"
        },
        {
          "set": "givens",
          "to": "minimalGivens(rules, fig.candidateGivens, fig.facts, goal, canon)"
        },
        {
          "set": "witness",
          "to": "proof(rules, givens, goal, fig.facts, canon)"
        },
        {
          "require": "witness != null && count(witness) >= minSteps && count(witness) <= maxSteps"
        },
        {
          "set": "relabel",
          "to": "randomLabels(keys(fig.points))"
        },
        {
          "apply": "relabel",
          "to": [
            "pts",
            "givens",
            "goal",
            "witness",
            "fig.facts"
          ]
        }
      ],
      "key": "fig.id + show(goal, grammar) + show(givens, grammar)",
      "scene": {
        "size": [
          360,
          260
        ],
        "items": [
          {
            "each": "f in fig.facts",
            "if": "f[0] == 'segment'",
            "draw": "line",
            "from": "pts[f[1]]",
            "to": "pts[f[2]]"
          },
          {
            "each": "name in keys(pts)",
            "draw": "label",
            "at": "pts[name]",
            "text": "name",
            "offset": "outward"
          }
        ]
      },
      "prompt": "Given: {join(map(givens, g => show(g, grammar)), '; ')}.\nProve: {show(goal, grammar)}.",
      "input": {
        "type": "stepChain",
        "mode": "mode",
        "points": "keys(pts)",
        "statement": "grammar",
        "reasons": "rules",
        "cites": {
          "to": "lines",
          "max": 3
        },
        "prefill": "mode == 'fillIn' ? map(witness, w => ({stmt: w.stmt})) : []",
        "maxLines": "count(witness) + 3"
      },
      "derive": {
        "j": "ln => justify(ln, s.lines, rules, givens, fig.facts, canon)"
      },
      "check": [
        {
          "id": "line",
          "each": "s.lines",
          "as": "ln",
          "pts": 1,
          "capPts": "count(witness)",
          "test": "j(ln).ok",
          "blame": "ln.n",
          "msg": "Line {ln.n}: {j(ln).why}"
        },
        {
          "id": "goal",
          "pts": 2,
          "test": "any(s.lines, ln => matches(ln.stmt, goal, canon) && j(ln).ok)",
          "msg": "No justified line states what you were asked to prove: {show(goal, grammar)}."
        }
      ],
      "explain": [],
      "selftest": {
        "n": 4,
        "witnessAsAnswer": "{lines: witness}",
        "corrupt": [
          {
            "name": "wrong reason on one line",
            "mutate": "swapReason(s, pick(rules).id)",
            "mustFail": [
              "line"
            ]
          },
          {
            "name": "drop a middle line",
            "mutate": "dropLine(s, randint(1, count(s.lines) - 2))",
            "mustFail": [
              "line",
              "goal"
            ]
          },
          {
            "name": "cite a later line",
            "mutate": "citeForward(s)",
            "mustFail": [
              "line"
            ]
          }
        ]
      },
      "answer": "join(map(witness, w => w.n + '. ' + show(w.stmt, grammar) + ' (' + w.reason + (count(w.cites) > 0 ? ' ' + join(w.cites, ',') : '') + ')'), '  ')"
    }
  }
}