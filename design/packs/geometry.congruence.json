        "show": "{0} ≅ {1}",
        "sameKind": true
      },
      "midpoint": {
        "args": [
          "pt",
          "pt",
          "pt"
        ],
        "show": "{0} is the midpoint of {1}{2}"
      },
      "segment": {
        "args": [
          "pt",
          "pt"
        ],
